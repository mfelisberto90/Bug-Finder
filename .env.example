# Bug-Finder Environment Configuration Example
# Copy to .env and adjust values for your environment. Never commit real secrets.

# Runtime environment: "development" (loopback dev ergonomics) or "production" (strict fail-closed)
BUGFINDER_ENV=production

# HTTP listen address
BUGFINDER_BIND=127.0.0.1:8080

# Persistent data directory (SQLite DB, .app_key, and uploaded sourcemaps)
BUGFINDER_DATA_DIR=./data

# Optional PostgreSQL connection URL (run migrations as owner first, run app as NOBYPASSRLS role)
# DATABASE_URL=postgres://bugfinder_app:CHANGE_ME@127.0.0.1:5432/bugfinder?sslmode=require

# Master encryption/HMAC key (>= 32 chars, e.g. `openssl rand -hex 32`)
# Required outside loopback development if .app_key does not yet exist.
# BUGFINDER_APP_KEY=replace_with_at_least_32_character_random_secret_hex

# Canonical HTTPS public origin (used for Connect App snippets, WebAuthn RP/origin, and OIDC callbacks)
# BUGFINDER_PUBLIC_URL=https://errors.example.com

# Comma-separated Host header allowlist (wildcards like '*' are rejected)
# BUGFINDER_ALLOWED_HOSTS=errors.example.com,localhost,127.0.0.1

# Comma-separated reverse proxy CIDRs or presets (loopback, private, cloudflare)
# BUGFINDER_TRUSTED_PROXIES=loopback

# Set to 1 when terminating TLS upstream and forwarding HTTP to Bug-Finder
BUGFINDER_FORCE_SECURE_COOKIES=0

# Session lifetimes (hours, clamped 1..=720)
BUGFINDER_SESSION_TTL_HOURS=168
BUGFINDER_SESSION_IDLE_HOURS=24

# Storage & ingestion limits
BUGFINDER_MAX_UNZIPPED_BYTES=2097152
BUGFINDER_MAX_DB_MB=512
BUGFINDER_RETENTION_DAYS=30

# Skip SQLite/PG migration execution at boot (recommended after explicit `bugfinder migrate`)
BUGFINDER_SKIP_MIGRATIONS=0

# Harden Linux process dumpability (PR_SET_DUMPABLE=0)
BUGFINDER_ANTI_PTRACE=0

# Optional Bearer token for remote GET /metrics Prometheus scraping (mandatory if TRUSTED_PROXIES is non-empty)
# BUGFINDER_METRICS_TOKEN=replace_with_random_metrics_bearer_token

# Optional native SMTP TLS alert relay
# BUGFINDER_SMTP_HOST=smtp.example.com
# BUGFINDER_SMTP_PORT=587
# BUGFINDER_SMTP_TLS_MODE=starttls
# BUGFINDER_SMTP_USER=alerts@example.com
# BUGFINDER_SMTP_PASS=replace_with_smtp_password
# BUGFINDER_SMTP_FROM=Bug-Finder <alerts@example.com>

# Optional OIDC PKCE Single Sign-On (requires HTTPS issuer and BUGFINDER_PUBLIC_URL in production)
# BUGFINDER_OIDC_ISSUER=https://idp.example.com
# BUGFINDER_OIDC_CLIENT_ID=replace_with_client_id
# BUGFINDER_OIDC_CLIENT_SECRET=replace_with_client_secret
# BUGFINDER_OIDC_DISPLAY_NAME=Corporate SSO
